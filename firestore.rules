rules_version = '2';

// ============================================================
// Reglas de seguridad — RETO GYM 2026
//
// Modelo de confianza:
//  - Google Sheets es la interfaz/base de datos que administras a mano.
//    El Apps Script (SheetsBridge.gs) espeja cada cambio a Firestore con
//    la cuenta admin-sync@retogymfit.app — el ÚNICO uid con permiso de
//    escritura total (ADMIN_UID abajo). Firestore hace la app fluida.
//  - Cualquier usuario autenticado (incluso anónimo, necesario para el
//    onboarding) puede LEER: participantes, registros, pagos.
//  - Un participante reclama su perfil una vez (crea su doc con su authUid).
//  - Los registros los crea el dueño del perfil, id determinista
//    `${usuarioId}_${fecha}` (imposible doble registro o suplantar a otro).
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Escritura total: la cuenta de servicio del espejo Sheets → Firestore
    // (Apps Script) y el super usuario administrador de la app.
    function esAdmin() {
      return request.auth != null
        && (request.auth.uid == 'tA0K0stZlMggm29ullJK5EQ4jGs1'
            || request.auth.token.email == 'admin@retogymfit.app');
    }

    match /retos/{retoId} {
      allow read: if request.auth != null;
      allow write: if esAdmin();

      match /usuarios/{usuarioId} {
        allow read: if request.auth != null;
        allow write: if esAdmin();
        allow delete: if false;
        // Los participantes viven en la pestaña "Usuarios" del Google Sheet;
        // su documento en Firestore se crea al reclamar el perfil (primera
        // contraseña). Solo puedes crear un doc que te pertenezca a ti.
        allow create: if request.auth != null
          // reclamar exige cuenta con contraseña (las anónimas no tienen email)
          && request.auth.token.email != null
          && request.resource.data.authUid == request.auth.uid
          && request.resource.data.hasPassword == true
          && request.resource.data.nombre is string
          && request.resource.data.nombre.size() >= 2
          && request.resource.data.nombre.size() <= 80
          && request.resource.data.estado == 'Activo';
        allow update: if request.auth != null
          && request.auth.token.email != null
          // solo campos de sesión + foto de perfil, nada más
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['authUid', 'hasPassword', 'ultimoAcceso', 'photoURL'])
          // reclamar solo si está libre, o si ya eres el dueño
          && (!('authUid' in resource.data) || resource.data.authUid == null
              || resource.data.authUid == request.auth.uid)
          && request.resource.data.authUid == request.auth.uid
          // la foto (si viene) es la URL de descarga del avatar en Storage:
          // string corto y acotado para evitar abusos
          && (!('fotoPerfil' in request.resource.data)
              || (request.resource.data.fotoPerfil is string
                  && request.resource.data.fotoPerfil.size() <= 2000));
      }

      match /registros/{registroId} {
        allow read: if request.auth != null;
        allow write: if esAdmin();
        allow update, delete: if false;
        allow create: if request.auth != null
          // el perfil debe pertenecer a quien escribe
          && get(/databases/$(database)/documents/retos/$(retoId)/usuarios/$(request.resource.data.usuarioId)).data.authUid == request.auth.uid
          // id determinista: un registro por persona por día
          && registroId == request.resource.data.usuarioId + '_' + request.resource.data.fecha
          // campos mínimos coherentes; fecha real para que nadie infle el ranking
          && request.resource.data.fecha is string
          && request.resource.data.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.tipo is string
          && request.resource.data.tipo.size() <= 40
          && request.resource.data.nombre is string
          && request.resource.data.nombre.size() <= 80
          && request.resource.data.estatus in ['CUMPLE', 'NO CUMPLE', 'JUSTIFICADO', 'N/A']
          && request.resource.data.minutos is number
          && request.resource.data.calorias is number
          && request.resource.data.minutos >= 0 && request.resource.data.minutos <= 1440
          && request.resource.data.calorias >= 0 && request.resource.data.calorias <= 20000
          && request.resource.data.notas is string
          && request.resource.data.notas.size() <= 500;
      }

      match /pagos/{pagoId} {
        allow read: if request.auth != null;
        allow write: if esAdmin();
      }
    }
  }
}
