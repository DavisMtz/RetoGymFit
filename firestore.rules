rules_version = '2';

// ============================================================
// Reglas de seguridad — RETO GYM 2026
//
// Modelo de confianza:
//  - Google Sheets es la interfaz/base de datos que administras a mano.
//    El Apps Script (SheetsBridge.gs) espeja cada cambio a Firestore con
//    la cuenta admin-sync@retogymfit.app — el ÚNICO uid con permiso de
//    escritura total (ADMIN_UID abajo). Firestore hace la app fluida.
//  - Cualquier usuario autenticado (incluso anónimo, necesario para el
//    onboarding) puede LEER: participantes, registros, pagos.
//  - Un participante reclama su perfil una vez (crea su doc con su authUid).
//  - Los registros los crea el dueño del perfil, id determinista
//    `${usuarioId}_${fecha}` (imposible doble registro o suplantar a otro).
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Escritura total: la cuenta de servicio del espejo Sheets → Firestore
    // (Apps Script) y el super usuario administrador de la app.
    function esAdmin() {
      return request.auth != null
        && (request.auth.uid == 'tA0K0stZlMggm29ullJK5EQ4jGs1'
            || request.auth.token.email == 'admin@retogymfit.app');
    }

    // Identidad propia del Worker de recuperación de contraseña
    // (auth-worker/). NO es admin: abajo se le permite exactamente dos
    // cosas — leer un correo registrado y liberar ese perfil para que su
    // dueño cree contraseña nueva. Nada más.
    function esWorkerAuth() {
      return request.auth != null
        && request.auth.token.email == 'auth-worker@retogymfit.app';
    }

    match /retos/{retoId} {
      allow read: if request.auth != null;
      allow write: if esAdmin();

      match /usuarios/{usuarioId} {
        allow read: if request.auth != null;
        allow write: if esAdmin();
        allow delete: if false;

        // El email sintético de este perfil: u-{usuarioId}[-r{gen}]@{retoId}.
        // retogymfit.app — lo crea el cliente al hacer login/registro. No
        // valida el número exacto de reinicio (resetGen): las reglas no
        // convierten números a texto, así que cualquier sufijo -rN cuenta.
        function esCuentaDeEstePerfil() {
          return request.auth.token.email.lower()
            .matches('^u-' + usuarioId + '(-r[0-9]+)?@' + retoId + '\\.retogymfit\\.app$');
        }

        // Reclamo de perfil (primera vez, o tras un reinicio de acceso del
        // admin): sin código de equipo, cualquiera que abra la app puede
        // reclamar un perfil libre sabiendo el nombre (visible en la lista
        // de participantes) — aceptable para un reto privado por enlace.
        allow create: if request.auth != null
          && request.auth.token.email != null
          && esCuentaDeEstePerfil()
          && request.resource.data.keys().hasOnly(['nombre', 'estado', 'authUid', 'hasPassword', 'creadoEn', 'ultimoAcceso'])
          && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 80
          && request.resource.data.estado == 'Activo'
          && request.resource.data.authUid == request.auth.uid
          && request.resource.data.hasPassword == true
          && request.resource.data.creadoEn == request.time
          && request.resource.data.ultimoAcceso == request.time;

        allow update: if request.auth != null
          && request.auth.token.email != null
          // solo campos de sesión + foto de perfil + token de push + marca
          // de lectura de notificaciones, nada más
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['authUid', 'hasPassword', 'ultimoAcceso', 'photoURL', 'fcmToken', 'notifVistoEn'])
          && (
            // Caso normal: ya eres el dueño, actualizas tus campos de sesión.
            (resource.data.authUid == request.auth.uid && request.resource.data.authUid == request.auth.uid)
            ||
            // Caso reclamo: perfil libre (sin dueño, o reiniciado por el
            // admin) y tu cuenta es la sintética de este perfil.
            (
              (!('authUid' in resource.data) || resource.data.authUid == null)
              && resource.data.estado == 'Activo'
              && request.resource.data.authUid == request.auth.uid
              && request.resource.data.hasPassword == true
              && esCuentaDeEstePerfil()
            )
          )
          // la foto (si viene) es la URL de descarga del avatar en Storage:
          // string corto y acotado para evitar abusos
          && (!('fotoPerfil' in request.resource.data)
              || (request.resource.data.fotoPerfil is string
                  && request.resource.data.fotoPerfil.size() <= 2000))
          // token de FCM para notificaciones push (string acotado)
          && (!('fcmToken' in request.resource.data)
              || (request.resource.data.fcmToken is string
                  && request.resource.data.fcmToken.size() <= 512))
          // marca de lectura de la bandeja de notificaciones (timestamp)
          && (!('notifVistoEn' in request.resource.data)
              || request.resource.data.notifVistoEn is timestamp);

        // Recuperación de contraseña: tras validar el código que mandó por
        // correo, el Worker libera el perfil igual que hace el admin —
        // authUid a null, sin contraseña y resetGen+1, para que la app le
        // genere un email sintético nuevo y su dueño cree una contraseña
        // fresca. Solo esos tres campos, y solo sobre un perfil Activo.
        allow update: if esWorkerAuth()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['authUid', 'hasPassword', 'resetGen'])
          && resource.data.estado == 'Activo'
          && request.resource.data.authUid == null
          && request.resource.data.hasPassword == false;
      }

      // ——— Correo real del participante, solo para recuperar la contraseña.
      // Vive fuera de usuarios/{id} a propósito: ese documento lo puede leer
      // CUALQUIER cuenta autenticada (incluso anónima), así que un correo ahí
      // quedaría a la vista de todo el reto. Aquí lo leen únicamente su dueño
      // y el Worker de recuperación.
      match /correos/{usuarioId} {
        allow read: if esWorkerAuth() || esAdmin()
          || (request.auth != null && resource.data.authUid == request.auth.uid);

        // Lo escribe el propio dueño desde Perfil: las reglas exigen que el
        // perfil ya sea suyo, así nadie registra un correo en cuenta ajena.
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['email', 'authUid', 'actualizadoEn'])
          && request.resource.data.authUid == request.auth.uid
          && get(/databases/$(database)/documents/retos/$(retoId)/usuarios/$(usuarioId))
               .data.authUid == request.auth.uid
          && request.resource.data.email is string
          && request.resource.data.email.size() <= 254
          && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]{2,}$')
          && request.resource.data.actualizadoEn == request.time;

        allow update: if request.auth != null
          && resource.data.authUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['email', 'authUid', 'actualizadoEn'])
          && request.resource.data.authUid == request.auth.uid
          && request.resource.data.email is string
          && request.resource.data.email.size() <= 254
          && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]{2,}$')
          && request.resource.data.actualizadoEn == request.time;

        // Quitar el correo: solo su dueño (o el admin al depurar el padrón).
        allow delete: if esAdmin()
          || (request.auth != null && resource.data.authUid == request.auth.uid);
      }

      match /registros/{registroId} {
        allow read: if request.auth != null;
        allow write: if esAdmin();
        allow update, delete: if false;
        allow create: if request.auth != null
          // el perfil debe pertenecer a quien escribe
          && get(/databases/$(database)/documents/retos/$(retoId)/usuarios/$(request.resource.data.usuarioId)).data.authUid == request.auth.uid
          // id determinista: un registro por persona por día
          && registroId == request.resource.data.usuarioId + '_' + request.resource.data.fecha
          // campos mínimos coherentes; fecha real para que nadie infle el ranking
          && request.resource.data.fecha is string
          && request.resource.data.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.tipo is string
          && request.resource.data.tipo.size() <= 40
          && request.resource.data.nombre is string
          && request.resource.data.nombre.size() <= 80
          && request.resource.data.estatus in ['CUMPLE', 'NO CUMPLE', 'JUSTIFICADO', 'N/A']
          && request.resource.data.minutos is number
          && request.resource.data.calorias is number
          && request.resource.data.minutos >= 0 && request.resource.data.minutos <= 1440
          && request.resource.data.calorias >= 0 && request.resource.data.calorias <= 20000
          && request.resource.data.notas is string
          && request.resource.data.notas.size() <= 500;
      }

      match /pagos/{pagoId} {
        allow read: if request.auth != null;
        allow write: if esAdmin();
      }

      // ——— Configuración privada del reto: la leen solo las Cloud
      // Functions (Admin SDK) y el super usuario. Ningún cliente.
      match /privado/{docId} {
        allow read, write: if esAdmin();
      }

      // ——— Eventos de notificación (reacciones, comentarios, menciones y
      // high-fives hacia otro): los crea el cliente y los consume/borra el
      // emisor de push (Apps Script, cuenta admin). Nadie más los lee.
      match /eventos/{eventoId} {
        allow read, update, delete: if esAdmin();
        allow create: if request.auth != null
          && request.auth.token.email != null
          && request.resource.data.deAuthUid == request.auth.uid
          && request.resource.data.tipo in ['reaccion', 'comentario', 'highfive', 'mencion']
          && request.resource.data.deNombre is string
          && request.resource.data.deNombre.size() <= 80
          && request.resource.data.paraAuthUid is string
          && request.resource.data.paraAuthUid.size() <= 128
          && request.resource.data.detalle is string
          && request.resource.data.detalle.size() <= 120
          && request.resource.data.postTexto is string
          && request.resource.data.postTexto.size() <= 80;
      }

      // ——— Bandeja de notificaciones in-app (independiente de `eventos`,
      // que el Apps Script borra tras enviar el push). Cada acción social
      // escribe aquí una copia dirigida; cada quien LEE y BORRA solo lo suyo.
      // El estado leído/no leído no vive aquí: es la marca `notifVistoEn`
      // del documento del usuario.
      match /notificaciones/{notifId} {
        allow read: if esAdmin()
          || (request.auth != null && resource.data.paraAuthUid == request.auth.uid);
        allow update: if esAdmin();
        allow delete: if esAdmin()
          || (request.auth != null && resource.data.paraAuthUid == request.auth.uid);
        allow create: if request.auth != null
          && request.auth.token.email != null
          && request.resource.data.deAuthUid == request.auth.uid
          && request.resource.data.tipo in ['reaccion', 'comentario', 'highfive', 'mencion']
          && request.resource.data.deNombre is string
          && request.resource.data.deNombre.size() <= 80
          && request.resource.data.deUsuarioId is string
          && request.resource.data.deUsuarioId.size() <= 80
          && request.resource.data.paraAuthUid is string
          && request.resource.data.paraAuthUid.size() <= 128
          && request.resource.data.detalle is string
          && request.resource.data.detalle.size() <= 120
          && request.resource.data.postTexto is string
          && request.resource.data.postTexto.size() <= 80
          // referencia al post para navegar al tocar la notificación
          && request.resource.data.postId is string
          && request.resource.data.postId.size() <= 40;
      }

      // ——— Feed social: publicaciones con texto/foto, reacciones y comentarios.
      match /posts/{postId} {
        allow read: if request.auth != null;
        allow write: if esAdmin();
        // Publicar: solo con cuenta de participante (con email) y a tu nombre.
        allow create: if request.auth != null
          && request.auth.token.email != null
          && request.resource.data.authUid == request.auth.uid
          && request.resource.data.usuarioId is string
          && request.resource.data.usuarioId.size() <= 80
          && request.resource.data.nombre is string
          && request.resource.data.nombre.size() >= 2
          && request.resource.data.nombre.size() <= 80
          && request.resource.data.texto is string
          && request.resource.data.texto.size() <= 500
          // debe traer texto, foto o una actividad registrada (autopost)
          && (request.resource.data.texto.size() > 0
              || request.resource.data.fotoURL is string
              || request.resource.data.actividad is map)
          && (!('fotoURL' in request.resource.data)
              || request.resource.data.fotoURL == null
              || (request.resource.data.fotoURL is string && request.resource.data.fotoURL.size() <= 2000))
          // autopost de registro: tarjeta con la actividad del día, acotada
          && (!('actividad' in request.resource.data)
              || (request.resource.data.actividad is map
                  && request.resource.data.actividad.tipo is string
                  && request.resource.data.actividad.tipo.size() <= 40
                  && request.resource.data.actividad.minutos is number
                  && request.resource.data.actividad.calorias is number
                  && request.resource.data.actividad.racha is number))
          && request.resource.data.reacciones is map
          && request.resource.data.reacciones.size() == 0
          && request.resource.data.numComentarios == 0;
        // El autor puede borrar su publicación.
        allow delete: if request.auth != null && resource.data.authUid == request.auth.uid;
        // Dos actualizaciones permitidas a cualquier participante:
        //  1) reaccionar — solo puede tocar SU llave (su uid) del mapa de reacciones
        //  2) contador de comentarios — exactamente ±1 (lo mueve quien comenta/borra)
        allow update: if request.auth != null
          && request.auth.token.email != null
          && (
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reacciones'])
              && request.resource.data.reacciones.diff(resource.data.reacciones)
                   .affectedKeys().hasOnly([request.auth.uid]))
            ||
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['numComentarios'])
              && request.resource.data.numComentarios is int
              && request.resource.data.numComentarios >= 0
              && (request.resource.data.numComentarios == resource.data.numComentarios + 1
                  || request.resource.data.numComentarios == resource.data.numComentarios - 1))
          );

        match /comentarios/{comentarioId} {
          allow read: if request.auth != null;
          allow write: if esAdmin();
          allow create: if request.auth != null
            && request.auth.token.email != null
            && request.resource.data.authUid == request.auth.uid
            && request.resource.data.usuarioId is string
            && request.resource.data.usuarioId.size() <= 80
            && request.resource.data.nombre is string
            && request.resource.data.nombre.size() >= 2
            && request.resource.data.nombre.size() <= 80
            && request.resource.data.texto is string
            && request.resource.data.texto.size() >= 1
            && request.resource.data.texto.size() <= 300;
          // Cada quien puede borrar su comentario.
          allow delete: if request.auth != null && resource.data.authUid == request.auth.uid;
        }
      }
    }
  }
}
