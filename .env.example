# Copia este archivo a .env y llena con los datos de tu proyecto Firebase
# (Firebase Console → Project settings → General → Your apps → SDK setup)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Webhooks de Apps Script para seguir alimentando las hojas de Google Sheets
# (URL de despliegue del Web App de apps-script/SheetsBridge.gs en cada hoja)
VITE_SHEETS_WEBHOOK_MIXTO=
VITE_SHEETS_WEBHOOK_DAMAS=

# Token compartido con el Apps Script (el mismo valor que TOKEN en SheetsBridge.gs)
VITE_SHEETS_WEBHOOK_TOKEN=
