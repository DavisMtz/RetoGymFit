rules_version = '2';

// ============================================================
// Storage — RETO GYM 2026 · fotos de perfil
//
//  - Cada avatar vive en  avatars/{uid}  donde uid = Firebase Auth uid.
//  - Lectura pública: los avatares se muestran en el ranking a todo el
//    equipo (proyecto personal). Escritura/borrado: solo su dueño.
//  - Límite 5 MB y solo imágenes.
// ============================================================

service firebase.storage {
  match /b/{bucket}/o {
    match /avatars/{uid} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Fotos del feed social: cada quien escribe solo bajo su uid.
    match /feed/{uid}/{archivo} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
