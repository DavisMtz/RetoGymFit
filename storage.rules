rules_version = '2';

// ============================================================
// Reglas de Storage — RETO GYM 2026
//
// Sólo se guardan aquí las fotos de perfil, en `avatares/{uid}/perfil.jpg`.
// La ruta va atada al uid de Firebase Auth: así el dueño (mismo uid, con
// cuenta de email/contraseña) es el único que puede subir o borrar su avatar,
// sin que Storage tenga que consultar Firestore. La URL de descarga (con
// token) se guarda en `retos/{reto}/usuarios/{id}.fotoPerfil`.
// ============================================================

service firebase.storage {
  match /b/{bucket}/o {

    match /avatares/{uid}/{archivo} {
      // Cualquier participante autenticado puede ver los avatares.
      allow read: if request.auth != null;

      // Sólo el dueño (mismo uid, cuenta con contraseña) sube su foto,
      // y sólo imágenes de hasta 2 MB.
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email != null
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      // Sólo el dueño puede borrar su foto.
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Todo lo demás queda cerrado.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
